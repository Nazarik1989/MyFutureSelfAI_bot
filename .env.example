TELEGRAM_BOT_TOKEN=

AI_PROVIDER=openrouter
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-5.4-mini
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=MyFutureSelfAI

# Nova guided-help AI fallback. Keep disabled and admin-only until the pilot is enabled.
ENABLE_NOVA_AI=false
NOVA_AI_ADMIN_ONLY=true

# Conversation-first Nova Companion. Keep disabled and admin-only until its pilot.
ENABLE_NOVA_COMPANION=false
NOVA_COMPANION_ADMIN_ONLY=true
ENABLE_NOVA_CONVERSATION_BRAIN=false
NOVA_CONVERSATION_BRAIN_ADMIN_ONLY=true
NOVA_CONVERSATION_BRAIN_MAX_MEMORIES=100
NOVA_CONVERSATION_BRAIN_RETRIEVAL_ITEMS=6
NOVA_CONVERSATION_BRAIN_CONTEXT_BYTES=8192

# Nova memory CRUD and AI-answer application use independent fail-closed rollout gates.
ENABLE_NOVA_MEMORY=false
NOVA_MEMORY_ADMIN_ONLY=true
ENABLE_NOVA_MEMORY_APPLICATION=false
NOVA_MEMORY_APPLICATION_ADMIN_ONLY=true
NOVA_MEMORY_MAX_ITEMS=100

TRANSCRIPTION_PROVIDER=disabled
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# OpenRouter Images API. Reuses AI_API_KEY/AI_BASE_URL; never uses the STT key.
ENABLE_VISION_IMAGE_GENERATION=false
VISION_IMAGE_ADMIN_ONLY=true
IMAGE_GENERATION_MODEL=openai/gpt-image-2
IMAGE_GENERATION_SIZE=1024x1024
IMAGE_GENERATION_QUALITY=medium
IMAGE_GENERATION_TIMEOUT_SECONDS=150

DATABASE_URL=sqlite+aiosqlite:///./future_self.db
SQLITE_WAL_ENABLED=true
SQLITE_BUSY_TIMEOUT_MS=5000
RUNTIME_MIN_FREE_BYTES=1073741824
RUNTIME_MIN_FREE_INODES=10000
DEFAULT_TIMEZONE=Europe/Moscow
BOT_PERSONA_NAME=Моя будущая версия
BOT_TONE=спокойный, конкретный, без осуждения
MORNING_HOUR=8
EVENING_HOUR=21
WEEKLY_REVIEW_WEEKDAY=6
MAX_AUDIO_SECONDS=180
MAX_AUDIO_BYTES=20000000
INTENT_CONFIDENCE_THRESHOLD=0.70
INBOX_DRAFT_TTL_MINUTES=60
DRAFT_FOCUS_TTL_MINUTES=15
SYSTEM_ACTION_TTL_MINUTES=10
CONVERSATION_CONTEXT_MESSAGES=20
CONVERSATION_CONTEXT_TTL_HOURS=24
TASK_DATE_EVENT_HOUR=9
TASK_REMINDER_LEAD_MINUTES=30
TASK_REMINDER_POLL_SECONDS=15
TASK_REMINDER_LEASE_SECONDS=120
RECURRING_TASK_REMINDER_GRACE_MINUTES=120
ENABLE_TASK_REMINDERS=true

# Guest quota/session foundation. AI provider execution remains disconnected.
GUEST_AI_ENABLED=true
GUEST_OPERATION_LIMIT=2
GUEST_GLOBAL_DAILY_LIMIT=50
GUEST_RESERVATION_TTL_MINUTES=10
GUEST_INPUT_TTL_MINUTES=15
GUEST_RESULT_TTL_MINUTES=15

COLLECTION_ACTION_TTL_MINUTES=15
COLLECTION_INPUT_TTL_MINUTES=20
COLLECTION_CONTEXT_TTL_MINUTES=20

# PR #23 Access/Workspace foundation. Enable only after migration 0018 and the
# production ACL smoke checks; this does not enable capture or Knowledge flows.
ENABLE_WORKSPACE_ACCESS=false

# PR #24 Knowledge Hub/Capture/Runner are independently rollout-gated and off by
# default. Retrieval/OCR/embeddings/Council/export remain reserved and unimplemented.
ENABLE_KNOWLEDGE_HUB=false
ENABLE_KNOWLEDGE_CAPTURE=false
ENABLE_KNOWLEDGE_RUNNER=false
ENABLE_KNOWLEDGE_RETRIEVAL=false
ENABLE_KNOWLEDGE_EMBEDDINGS=false
ENABLE_KNOWLEDGE_OCR=false
ENABLE_KNOWLEDGE_MEDIA=false
ENABLE_EXTERNAL_VISION=false
ENABLE_COUNCIL=false
ENABLE_SCHEDULED_COUNCIL=false
ENABLE_KNOWLEDGE_EXPORT=false
KNOWLEDGE_ASSET_ROOT=/data/knowledge
KNOWLEDGE_RUNNER_CONCURRENCY=1
KNOWLEDGE_MAX_SOURCE_BYTES=26214400
KNOWLEDGE_DAILY_INGEST_BYTES_PER_USER=104857600
KNOWLEDGE_STORAGE_QUOTA_BYTES_PER_USER=1073741824
KNOWLEDGE_DAILY_SOURCES_PER_USER=20
KNOWLEDGE_MAX_PENDING_JOBS_PER_USER=4
KNOWLEDGE_DAILY_INGEST_BYTES_PER_SPACE=262144000
KNOWLEDGE_STORAGE_QUOTA_BYTES_PER_SPACE=5368709120
KNOWLEDGE_DAILY_SOURCES_PER_SPACE=100
KNOWLEDGE_MAX_PENDING_JOBS_PER_SPACE=20
KNOWLEDGE_CAPTURE_TTL_MINUTES=30
KNOWLEDGE_ACTION_TTL_MINUTES=15
KNOWLEDGE_STAGING_TTL_MINUTES=60
KNOWLEDGE_RUNNER_POLL_SECONDS=2
KNOWLEDGE_RUNNER_LEASE_SECONDS=120
KNOWLEDGE_RUNNER_HEARTBEAT_SECONDS=30
KNOWLEDGE_RUNNER_MAX_ATTEMPTS=3
KNOWLEDGE_EXTRACTION_WALL_SECONDS=30
KNOWLEDGE_EXTRACTION_MAX_PAGES=500
KNOWLEDGE_EXTRACTION_MAX_ARCHIVE_ENTRIES=2000
KNOWLEDGE_EXTRACTION_MAX_UNPACKED_BYTES=104857600
KNOWLEDGE_EXTRACTION_MAX_TEXT_BYTES=10485760
KNOWLEDGE_PROVIDER_DAILY_TOKEN_BUDGET_PER_USER=100000
KNOWLEDGE_EXTERNAL_PROCESSING_REQUIRES_CONSENT=true
KNOWLEDGE_DEFAULT_APPLY_MODE=brief_reminder
KNOWLEDGE_MAX_QUOTE_CHARS=400
COUNCIL_DAILY_SESSIONS_PER_USER=5
COUNCIL_EVIDENCE_MAX_CHUNKS=12
COUNCIL_EVIDENCE_MAX_CHARS=40000

ENABLE_VOICE=true
ENABLE_WEEKLY_REVIEW=true
WEEKLY_REVIEW_ADMIN_ONLY=true
LOG_LEVEL=INFO
